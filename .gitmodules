[submodule "workers-sdk"]
	path = upstream/workers-sdk
	url = https://github.com/cloudflare/workers-sdk.git
[submodule "upstream/next.js"]
	path = upstream/next.js
	url = https://github.com/vercel/next.js
	shallow = true
[submodule "upstream/opennextjs-cloudflare"]
	path = upstream/opennextjs-cloudflare
	url = https://github.com/opennextjs/opennextjs-cloudflare
	shallow = true
[submodule "upstream/astro"]
	path = upstream/astro
	url = https://github.com/withastro/astro
	shallow = true
[submodule "upstream/sveltekit"]
	path = upstream/sveltekit
	url = https://github.com/sveltejs/kit
	shallow = true
[submodule "upstream/waku"]
	path = upstream/waku
	url = https://github.com/wakujs/waku
	shallow = true
[submodule "upstream/nuxt"]
	path = upstream/nuxt
	url = https://github.com/nuxt/nuxt
	shallow = true
[submodule "upstream/nitro"]
	path = upstream/nitro
	url = https://github.com/nitrojs/nitro
	shallow = true
[submodule "upstream/nitro-cloudflare-dev"]
	path = upstream/nitro-cloudflare-dev
	url = https://github.com/nitrojs/nitro-cloudflare-dev
	shallow = true
