{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "overrides": [
    {
      "files": ["**/*.{json,jsonc}"],
      "options": {
        "trailingComma": "none"
      }
    }
  ],
  "ignorePatterns": [
    "upstream",
    "**/dist/**",
    "**/routeTree.gen.ts",
    "**/__snapshots__/**",
    "fixtures/spike-*",
    "research",
    "**/.svelte-kit/**",
    "**/test-results/**"
  ]
}
