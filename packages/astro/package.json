{
  "name": "@distilled.cloud/astro",
  "version": "0.13.7",
  "description": "Programmatic Astro integration implementing the framework-core Framework service (build/dev), with the deploy target passed as a value; ships the wrangler-free Cloudflare Workers target (a fork of @astrojs/cloudflare over @distilled.cloud/cloudflare-vite-plugin) at the ./cloudflare subpath.",
  "keywords": [
    "astro",
    "cloudflare",
    "vite",
    "workers"
  ],
  "homepage": "https://github.com/alchemy-run/cloudflare-tools/tree/main/packages/astro#readme",
  "bugs": {
    "url": "https://github.com/alchemy-run/cloudflare-tools/issues"
  },
  "license": "MIT",
  "author": {
    "name": "John Royal",
    "email": "john@alchemy.run",
    "url": "https://distilled.cloud"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/cloudflare-tools.git",
    "directory": "packages/astro"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cloudflare": {
      "bun": "./src/cloudflare.ts",
      "types": "./dist/cloudflare.d.ts",
      "import": "./dist/cloudflare.js",
      "default": "./dist/cloudflare.js"
    },
    "./source": {
      "bun": "./src/source.ts",
      "types": "./dist/source.d.ts",
      "import": "./dist/source.js",
      "default": "./dist/source.js"
    },
    "./entrypoints/server": {
      "types": "./dist/runtime/entrypoints/server.d.ts",
      "default": "./dist/runtime/entrypoints/server.js"
    },
    "./image-passthrough-endpoint": {
      "types": "./dist/runtime/entrypoints/image-passthrough-endpoint.d.ts",
      "default": "./dist/runtime/entrypoints/image-passthrough-endpoint.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist .cache",
    "dev": "tsc -b --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@astrojs/internal-helpers": "0.10.1",
    "@distilled.cloud/cloudflare-vite-plugin": "workspace:*",
    "@distilled.cloud/framework-core": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:workers",
    "@effect/platform-node": "catalog:effect",
    "astro": "7.1.0",
    "effect": "catalog:effect",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "astro": "^7.0.0",
    "effect": "catalog:effect",
    "vite": "^8.0.0"
  }
}
