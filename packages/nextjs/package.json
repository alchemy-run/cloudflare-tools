{
  "name": "@distilled.cloud/nextjs",
  "version": "0.13.7",
  "description": "Next.js framework integration for Cloudflare Workers: OpenNext-based build pipeline and cloudflare-runtime dev server, wrangler-free.",
  "keywords": [
    "cloudflare",
    "nextjs",
    "opennext",
    "workers"
  ],
  "homepage": "https://github.com/alchemy-run/cloudflare-tools/tree/main/packages/nextjs#readme",
  "bugs": {
    "url": "https://github.com/alchemy-run/cloudflare-tools/issues"
  },
  "license": "MIT",
  "author": {
    "name": "John Royal",
    "email": "john@alchemy.run",
    "url": "https://distilled.cloud"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/cloudflare-tools.git",
    "directory": "packages/nextjs"
  },
  "files": [
    "dist",
    "src",
    "wrangler-stub"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./source": {
      "bun": "./src/source.ts",
      "types": "./dist/source.d.ts",
      "import": "./dist/source.js",
      "default": "./dist/source.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && cp src/runner.mjs dist/runner.mjs",
    "clean": "rm -rf dist .cache",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "bun run clean && bun run build"
  },
  "dependencies": {
    "@distilled.cloud/cloudflare": "catalog:",
    "@distilled.cloud/cloudflare-runtime": "workspace:*",
    "@distilled.cloud/framework-core": "workspace:*",
    "@effect/platform-node": "catalog:effect",
    "esbuild": "^0.25.4"
  },
  "devDependencies": {
    "effect": "catalog:effect",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@opennextjs/cloudflare": "1.20.1",
    "effect": "catalog:effect"
  },
  "peerDependenciesMeta": {
    "@opennextjs/cloudflare": {
      "optional": true
    }
  }
}
