{
  "name": "@distilled.cloud/nuxt",
  "version": "0.13.7",
  "description": "Nuxt integration for Cloudflare Workers: programmatic build over the project's @nuxt/kit with nitro's cloudflare_module preset, wrangler-free.",
  "keywords": [
    "cloudflare",
    "nitro",
    "nuxt",
    "workers"
  ],
  "homepage": "https://github.com/alchemy-run/cloudflare-tools/tree/main/packages/nuxt#readme",
  "bugs": {
    "url": "https://github.com/alchemy-run/cloudflare-tools/issues"
  },
  "license": "MIT",
  "author": {
    "name": "John Royal",
    "email": "john@alchemy.run",
    "url": "https://distilled.cloud"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/cloudflare-tools.git",
    "directory": "packages/nuxt"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cloudflare": {
      "bun": "./src/cloudflare.ts",
      "types": "./dist/cloudflare.d.ts",
      "import": "./dist/cloudflare.js",
      "default": "./dist/cloudflare.js"
    },
    "./source": {
      "bun": "./src/source.ts",
      "types": "./dist/source.d.ts",
      "import": "./dist/source.js",
      "default": "./dist/source.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist .cache",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "bun run clean && bun run build"
  },
  "dependencies": {
    "@distilled.cloud/cloudflare-runtime": "workspace:*",
    "@distilled.cloud/framework-core": "workspace:*",
    "fast-glob": "^3.3.2"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:effect",
    "effect": "catalog:effect",
    "nitropack": "2.13.4",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:effect",
    "nuxt": ">=4.5.0"
  },
  "peerDependenciesMeta": {
    "nuxt": {
      "optional": true
    }
  }
}
