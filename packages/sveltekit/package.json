{
  "name": "@distilled.cloud/sveltekit",
  "version": "0.13.7",
  "description": "SvelteKit integration for Cloudflare Workers: wrangler-free in-memory adapter, programmatic build with a workerd re-bundle pass, and dev via SvelteKit's own Vite server.",
  "keywords": [
    "cloudflare",
    "sveltekit",
    "vite",
    "workers"
  ],
  "homepage": "https://github.com/alchemy-run/cloudflare-tools/tree/main/packages/sveltekit#readme",
  "bugs": {
    "url": "https://github.com/alchemy-run/cloudflare-tools/issues"
  },
  "license": "MIT",
  "author": {
    "name": "John Royal",
    "email": "john@alchemy.run",
    "url": "https://distilled.cloud"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/cloudflare-tools.git",
    "directory": "packages/sveltekit"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cloudflare": {
      "bun": "./src/cloudflare.ts",
      "types": "./dist/cloudflare.d.ts",
      "import": "./dist/cloudflare.js",
      "default": "./dist/cloudflare.js"
    },
    "./source": {
      "bun": "./src/source.ts",
      "types": "./dist/source.d.ts",
      "import": "./dist/source.js",
      "default": "./dist/source.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist .cache",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "bun run clean && bun run build"
  },
  "dependencies": {
    "@distilled.cloud/cloudflare-rolldown-plugin": "workspace:*",
    "@distilled.cloud/cloudflare-runtime": "workspace:*",
    "@distilled.cloud/framework-core": "workspace:*",
    "fast-glob": "^3.3.2",
    "rolldown": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:effect",
    "@sveltejs/kit": "3.0.0-next.9",
    "effect": "catalog:effect",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@sveltejs/kit": ">=3.0.0-next.9",
    "effect": "catalog:effect",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
